# ====================================================================
# NoorBot - تنظیمات متغیرهای محیطی (Environment Variables)
# ====================================================================

# توکن ربات تلگرام دریافت‌شده از @BotFather (الزامی)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz

# شناسه‌های عددی ادمین‌های ربات (با کاما جدا شود)
ADMIN_IDS=123456789,987654321

# آدرس پایگاه داده (PostgreSQL / Supabase یا SQLite برای اجرای محلی)
# نمونه Supabase / PostgreSQL:
# DATABASE_URL=postgresql://postgres.xxx:your_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
# نمونه اجرای محلی بدون نیاز به دیتابیس خارجی:
DATABASE_URL=sqlite:///noorbot.db

# پورت و آدرس اجرای سرور وب سلامت‌سنجی (سازگار با Render)
PORT=8080
HOST=0.0.0.0

# محیط اجرا: development یا production
ENVIRONMENT=development

# سطح لاگ: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# محدودیت نرخ درخواست‌ها (ضد اسپم): تعداد درخواست مجاز در پنجره زمانی (ثانیه)
RATE_LIMIT_BURST=5
RATE_LIMIT_WINDOW=3.0

# مرجع تقلید پیش‌فرض (sistani, khamenei, makarem)
DEFAULT_MARJA=sistani

# تفسیر پیش‌فرض (nemooneh, al-mizan, majma-al-bayan)
DEFAULT_TAFSIR=nemooneh
