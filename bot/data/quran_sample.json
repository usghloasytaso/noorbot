  "sample_verses": [
    {
      "surah": 1,
      "ayah": 1,
      "text": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ",
      "translation": "به نام خداوند بخشنده مهربان",
      "page": 1,
      "juz": 1
    },
    {
      "surah": 2,
      "ayah": 153,
      "text": "يَا أَيُّهَا الَّذِينَ آمَنُوا اسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ ۚ إِنَّ اللَّهَ مَعَ الصَّابِرِينَ",
      "translation": "ای افرادی که ایمان آورده‌اید! از صبر و نماز کمک بگیرید؛ زیرا خداوند با صابران است.",
      "page": 23,
      "juz": 2
    },
    {
      "surah": 2,
      "ayah": 186,
      "text": "وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ ۖ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ ۖ فَلْيَسْتَجِيبُوا لِي وَلْيُؤْمِنُوا بِي لَعَلَّهُمْ يَرْشُدُونَ",
      "translation": "و هنگامی که بندگانم از تو درباره من بپرسند، (بگو:) یقیناً من نزدیکم! دعای دعاکننده را، به هنگامی که مرا می‌خواند، پاسخ می‌گویم! پس باید دعوت مرا بپذیرند و به من ایمان بیاورند، تا راه یابند.",
      "page": 28,
      "juz": 2
    },
    {
      "surah": 2,
      "ayah": 255,
      "text": "اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ ۚ لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ ۚ لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ",
      "translation": "هیچ معبودی جز خداوندِ یگانه زنده و پاینده نیست. نه خوابی سبک او را فرا می‌گیرد و نه خوابی گران؛ آنچه در آسمان‌ها و زمین است از آنِ اوست.",
      "page": 42,
      "juz": 3
    },
    {
      "surah": 3,
      "ayah": 159,
      "text": "فَبِمَا رَحْمَةٍ مِنَ اللَّهِ لِنْتَ لَهُمْ ۖ وَلَوْ كُنْتَ فَظًّا غَلِيظَ الْقَلْبِ لَانْفَضُّوا مِنْ حَوْلِكَ ۖ فَاعْفُ عَنْهُمْ وَاسْتَغْفِرْ لَهُمْ وَشَاوِرْهُمْ فِي الْأَمْرِ ۖ فَإِذَا عَزَمْتَ فَتَوَكَّلْ عَلَى اللَّهِ",
      "translation": "به (برکت) رحمت الهی، در برابر آنان نرم (و مهربان) شدی! و اگر خشن و سنگدل بودی، از اطراف تو پراکنده می‌شدند. پس آنها را ببخش و برای آنها آمرزش بطلب و در کارها با آنان مشورت کن! اما هنگامی که تصمیم گرفتی، بر خدا توکل کن!",
      "page": 71,
      "juz": 4
    },
    {
